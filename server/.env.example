# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/fileclip

# ─── S3 / MinIO ───────────────────────────────────────────────────────────────
# For AWS S3: remove S3_ENDPOINT (or leave blank)
# For MinIO:  set S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=fileclip

# ─── Google Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── App ──────────────────────────────────────────────────────────────────────
# Base URL used for share links returned to the client
CLIENT_URL=http://localhost:3000

